# Copy to .env; replace placeholders. Prefer a long random hex password (URI safe).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
TRASH_DAYS=30
# Local Node runtime reads environment variables, not .env automatically.
# DATABASE_URL=postgresql://notera:REPLACE_WITH_RANDOM_HEX_SECRET@localhost:5432/notera
# Without DATABASE_URL: durable PGlite in .data/postgres (one process only).

# Optional: pin a published v-tag, sha-tag or digest instead of latest.
NOTERA_IMAGE=ghcr.io/skords83/notera:latest

# Empty = trust no forwarding headers. For Traefik, set only its actual source IP/CIDR.
# Example only, NOT a value to copy without inspecting your network:
# TRUSTED_PROXIES=172.30.50.2/32
TRUSTED_PROXIES=
