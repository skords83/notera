{
  "name": "notera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/service-worker.ts",
    "start": "node --import tsx src/server/index.ts",
    "user:add": "node --import tsx scripts/user.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx scripts/browser-test.ts",
    "backup": "node --import tsx scripts/backup.ts backup",
    "restore": "node --import tsx scripts/backup.ts restore",
    "maintain": "node --import tsx scripts/maintain.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@js-temporal/polyfill": "^0.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "fastify": "^5.12.5",
    "idb": "^8.0.4",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
